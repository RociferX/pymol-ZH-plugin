# Publish source and documentation only. Local runtimes, downloaded software,
# user molecule files, desktop shortcuts and working QA records stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CHANGELOG.md
!/environment-open-source.yml
!/pymol_zh_cn/
!/tests/
!/scripts/
!/docs/

__pycache__/
*.py[cod]
*.class
.DS_Store
Thumbs.db

/scripts/*
!/scripts/build_plugin.py
!/scripts/check_package.py
!/scripts/check_plugin_installation.py
!/scripts/check_form_layouts.py
!/scripts/inventory_translation.py
!/scripts/verify_output.py
!/scripts/run_gui_verification.py
!/scripts/verify_in_pymol.py
!/scripts/verify_object_panel.py
!/scripts/verify_details.py
!/scripts/verify_remaining.py
!/scripts/stock_forms.py
